{
  "name": "frontend",
  "version": "0.0.0",
  "prettier": "@openmfp/config-prettier",
  "scripts": {
    "ng": "ng",
    "extract-versions": "node ./build-scripts/extract-versions.js",
    "prebuild": "npm run extract-versions",
    "prebuild:watch": "npm run extract-versions",
    "prestart": "npm run extract-versions",
    "prestart:watch": "npm run extract-versions",
    "start": "ng serve --port 4300",
    "start:watch": "nodemon --watch .yalc -e * --exec \"rimraf .angular && ng serve --watch --port 4300\"",
    "build": "ng build",
    "build:watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular-builders/jest": "21.0.4",
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/elements": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/localize": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@fundamental-ngx/ui5-webcomponents": "^0.59.1",
    "@luigi-project/client": "^2.30.0",
    "@luigi-project/client-support-angular": "^21.1.0",
    "@luigi-project/core": "^2.30.0",
    "@luigi-project/plugin-auth-oauth2": "^2.30.0",
    "@openmfp/portal-ui-lib": "^0.192.48",
    "apollo-angular": "^13.0.0",
    "gql-query-builder": "^3.8.0",
    "graphql": "^16.12.0",
    "graphql-sse": "^2.6.0",
    "jmespath": "^0.16.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.23",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.17",
    "@briebug/jest-schematic": "6.0.0",
    "@openmfp/config-prettier": "0.9.2",
    "@openmfp/eslint-config-typescript": "0.7.7",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "nodemon": "3.1.14",
    "rimraf": "6.1.3",
    "typescript": "~5.9.3"
  }
